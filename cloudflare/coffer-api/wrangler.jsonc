{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aocch-coffer-api",
	"main": "src/index.ts",
  "compatibility_date": "2026-05-03",
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "ratelimits": [
    {
      "name": "OBSERVATION_IP_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "coffer-observations",
			"database_id": "255310b3-f922-4301-9921-0583272ca227",
			"migrations_dir": "migrations"
		}
	]
}
